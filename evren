def cmd_help(argv=None):
    print("USAGE")
    print("  evren <command> [options]")
    print('  evren "question"                same as ask')
    print('  evren img photo.jpg "question"  ask about an image')
    print("  evren ocr scan.png              extract text")
    print("  evren transcribe talk.m4a -l tr speech to text")
    print()
    print("COMMANDS")
    for name, (_, desc) in COMMANDS.items():
        print(f"  {name:<11} {desc}")
    print("  help        show this help")
    print()
    print("OPTIONS (ask, chat, img)")
    print("  -m model  -s system  -t max_tokens  --stream")
    print("  --think / --no-think   ask the model to think / not to think (--think also shows it)")
    print("  --show-thinking        show the thinking text without changing the request")
    print()
    print("MODEL PRIORITY")
    print("  -m  >  EVREN_MODEL (_VISION/_OCR/_ASR)  >  ~/.config/evren/config.json  >  built-in")
    print()
    print("API KEY")
    print(f"  {KEY_ENV_VAR} environment variable, or macOS Keychain (service '{KEYCHAIN_SERVICE}')")


def main():
    argv = sys.argv[1:]
    try:
        if not argv or argv[0] in ("help", "-h", "--help"):
            cmd_help()
        elif argv[0] in ("--version", "version"):
            print(f"evren {VERSION}")
        elif argv[0] in COMMANDS:
            COMMANDS[argv[0]][0](argv[1:])
        else:
            cmd_ask(argv)
    except httpx.TimeoutException:
        sys.exit("Error: request timed out. Try again.")
    except httpx.HTTPError as exc:
        sys.exit(f"Error: connection problem ({exc.__class__.__name__}).")
    except KeyboardInterrupt:
        sys.exit("\nCancelled.")


if __name__ == "__main__":
    main()
