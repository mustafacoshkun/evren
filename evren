def fmt(value):
    return f"{value:,}" if isinstance(value, int) else str(value)


def cmd_quota(argv):
    q = api_get("/quota").json()
    print(f"Daily  : {fmt(q.get('daily_used_tokens'))} / {fmt(q.get('daily_limit_tokens'))} used, "
          f"{fmt(q.get('daily_remaining_tokens'))} left")
    print(f"         resets: {q.get('daily_reset_at')}")
    print(f"Window : {fmt(q.get('used_tokens'))} / {fmt(q.get('cap'))} tokens "
          f"({q.get('window_minutes')} min), level: {q.get('level')}")
    print(f"         resets: {q.get('reset_at')}")


def cmd_terms(argv):
    parser = argparse.ArgumentParser(prog="evren terms", description="terms of use")
    parser.add_argument("action", nargs="?", default="status", choices=["status", "text", "accept"])
    parser.add_argument("--version", type=int, help="terms version for accept (see the status output)")
    args = parser.parse_args(argv)

    if args.action == "status":
        print(json.dumps(api_get("/terms/status").json(), indent=2, ensure_ascii=False))
    elif args.action == "text":
        resp = api_get("/terms/text")
        try:
            print(json.dumps(resp.json(), indent=2, ensure_ascii=False))
        except ValueError:
            print(resp.text)
    else:
        if args.version is None:
            sys.exit("Error: check the version with `evren terms` first, then: evren terms accept --version N")
        answer = input(f"I have read and accept version {args.version} of the terms (type 'yes' to confirm): ")
        if answer.strip().lower() != "yes":
            sys.exit("Cancelled, terms were not accepted.")
        with httpx.Client(timeout=30) as client:
            resp = client.post(f"{BASE_URL}/terms/accept", json={"version": args.version}, headers=auth_headers())
        if resp.status_code != 200:
            sys.exit(explain_http_error(resp.status_code, resp.text))
        print("Terms accepted.")


def cmd_doctor(argv):
    def line(ok, text):
        print(f"[{'OK' if ok else '!!'}] {text}")

    key, source = find_api_key()
    line(bool(key), f"API key found in {source}" if key else "no API key found (env var or Keychain)")
    if not key:
        return
    line(key.startswith("evren_llm_"), "key format starts with evren_llm_")

    with httpx.Client(timeout=30) as client:
        def probe(path):
            try:
                return client.get(f"{BASE_URL}{path}", headers=auth_headers())
            except httpx.HTTPError as exc:
                line(False, f"{path}: connection error ({exc.__class__.__name__})")
                return None

        resp = probe("/models")
        if resp is not None:
            line(resp.status_code == 200, f"/models returned HTTP {resp.status_code}")
        resp = probe("/terms/status")
        if resp is not None:
            line(resp.status_code == 200, f"/terms/status returned HTTP {resp.status_code} (details: `evren terms`)")
        resp = probe("/quota")
        if resp is not None and resp.status_code == 200:
            q = resp.json()
            line(q.get("level") == "ok", f"quota level: {q.get('level')}, daily remaining {fmt(q.get('daily_remaining_tokens'))}")
        elif resp is not None:
            line(False, f"/quota returned HTTP {resp.status_code}")

    for kind in MODEL_KINDS:
        model, src = resolve_model(kind)
        line(True, f"{kind} model: {model} ({src})")


